# Copy this file to .env and fill in real values. .env is git-ignored.
# DATABASE_URL comes from: Supabase dashboard -> Project Settings -> Database -> Connection string (use "Transaction" or "Session" pooler URI, or direct connection)

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
GROQ_API_KEY=
UPLIFTAI_API_KEY=
BOOKING_API_URL=http://localhost:8000
